{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template Configuration",
  "type": "object",
  "properties": {
    "templates": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9-_]+$": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["project", "monorepo", "package"],
              "description": "The category/kind of the template."
            },
            "template": {
              "type": "string",
              "description": "Local template path (relative or absolute)."
            },
            "repo": {
              "type": "string",
              "format": "uri",
              "description": "Remote repository URL (GitHub or GitLab)."
            },
            "includes": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Glob patterns for files to include."
            },
            "excludes": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Glob patterns for files to exclude."
            },
            "template_vars": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "placeholder": {
                    "type": "string",
                    "description": "The placeholder string used in template files, e.g. {{project_name}}."
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Prompt message shown to the user."
                  },
                  "default": {
                    "type": "string",
                    "description": "Default value if the user provides no input."
                  },
                  "includes_paths": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Glob patterns specifying files where this variable should be replaced."
                  }
                },
                "required": ["placeholder"]
              },
              "description": "List of template variables for replacement."
            },
            "completed_script": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Commands executed after template generation."
            }
          },
          "required": ["kind"]
        }
      }
    }
  },
  "required": ["templates"]
}